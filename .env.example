# Choose the model provider: "anthropic" (default), "openai" or "gemini"
LLM_PROVIDER=anthropic

# --- Anthropic (when LLM_PROVIDER=anthropic) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- OpenAI / ChatGPT models (when LLM_PROVIDER=openai) ---
OPENAI_API_KEY=
OPENAI_MODEL=            # required: set the exact ChatGPT model id you want

# --- Google Gemini (when LLM_PROVIDER=gemini) ---
GEMINI_API_KEY=
GEMINI_MODEL=            # required: set the exact Gemini model id you want
# Tip: "thinking" Gemini models spend output tokens on reasoning; consider LLM_MAX_OUTPUT_TOKENS=2000.

# --- Shared tuning (defaults shown) ---
LLM_TIMEOUT_MS=20000
LLM_MAX_OUTPUT_TOKENS=2000
RATE_LIMIT_MAX_REQUESTS=20
RATE_LIMIT_WINDOW_MS=60000
LOG_LEVEL=info
